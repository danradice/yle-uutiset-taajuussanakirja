cff-version: 1.2.0
title: >-
  Yle Uutisten taajuussanakirja — a news-based Finnish frequency
  dictionary
message: >-
  If you use this dictionary, please cite it using the metadata
  in this file.
type: dataset
authors:
  - given-names: Daniel
    family-names: Radice
    email: daniel.radice@helsinki.fi
    affiliation: University of Helsinki
    orcid: 'https://orcid.org/0009-0002-5206-6880'
# The concept DOI, which always resolves to the newest version; each release
# also has its own version DOI, shown on the Zenodo record page. It has to be
# this top-level key: GitHub's renderer reads `doi` and never `identifiers`,
# and otherwise falls back to `repository-code`, which outranks `url`.
doi: 10.5281/zenodo.22162057
repository-code: 'https://github.com/danradice/yle-uutiset-taajuussanakirja'
abstract: >-
  Corpus frequencies for the headwords of the Kotus nykysuomen
  sanalista, counted against the Yle Finnish News Archive
  (YLENEWS_FI) 2011-2024. 87 870 attested headwords with their
  sanalista word classes and total corpus occurrences, plus
  per-word-class subdictionaries. Counts are POS-merged because
  the corpus tagger is not reliable enough to split them; the
  43 homonyms whose senses are genuinely different parts of
  speech were disambiguated by hand.
keywords:
  - Finnish
  - frequency dictionary
  - taajuussanasto
  - corpus linguistics
  - lexicography
  - Yle
  - YLENEWS_FI
  - nykysuomen sanalista
  - Kielipankki
license: CC-BY-4.0
version: 1.1.1
date-released: '2026-08-31'
# Restated as the preferred citation so that the DOI, not the repository URL, is
# the link in *every* format: only APA prefers the DOI unaided, while BibTeX
# takes its url from repository-code unless the model is a reference. The
# publisher is accurate but never rendered by GitHub -- see CLAUDE.md. Every
# value duplicated here is checked against the original by
# scripts/check_release_metadata.py.
preferred-citation:
  type: data
  title: >-
    Yle Uutisten taajuussanakirja — a news-based Finnish frequency
    dictionary
  authors:
    - given-names: Daniel
      family-names: Radice
      affiliation: University of Helsinki
      orcid: 'https://orcid.org/0009-0002-5206-6880'
  year: 2026
  version: 1.1.1
  publisher:
    name: Zenodo
  doi: 10.5281/zenodo.22162057
  url: 'https://doi.org/10.5281/zenodo.22162057'
references:
  - type: database
    title: 'Yle Finnish News Archive 2011-2024, scrambled, VRT'
    authors:
      - name: Yle (Yleisradio Oy / the Finnish Broadcasting Company)
    license: CC-BY-4.0
    notes: >-
      Distributed by FIN-CLARIN / The Language Bank of Finland
      (Kielipankki). Source of the "count" column. Three packages:
      2011-2018 (urn:nbn:fi:lb-2020021107), 2019-2021
      (urn:nbn:fi:lb-2022082503), 2022-2024
      (urn:nbn:fi:lb-2025110405).
    url: 'http://urn.fi/urn:nbn:fi:lb-2020021107'
  - type: data
    title: Nykysuomen sanalista
    authors:
      - name: >-
          Kotimaisten kielten keskus (Institute for the Languages
          of Finland)
    license: CC-BY-4.0
    notes: >-
      Source of the "Hakusana" and "Sanaluokat" columns, and
      redistributed unmodified as
      word_lists/nykysuomensanalista2024.txt.
    url: >-
      https://kotus.fi/sanakirjat/kielitoimiston-sanakirja/nykysuomen-sana-aineistot/nykysuomen-sanalista/
